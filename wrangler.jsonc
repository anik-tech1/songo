{
  "name": "songo",
  "main": "src/index.ts",
  "compatibility_date": "2024-12-01",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "songo-db",
      "database_id": "2c0e7d70-33c2-44e6-9384-9b0d60a09b6c"
    }
  ],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "vars": {
    "B2_BUCKET": "songo-music",
    "B2_BUCKET_ID": "b3cce0928a594a74a402011d"
  }
}
